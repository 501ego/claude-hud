{
  "name": "claude-hud",
  "version": "0.0.19",
  "description": "Real-time statusline HUD for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "commands/",
    "scripts/",
    ".claude-plugin/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov node --test",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 npm test",
    "test:stdin": "npm run build && echo '{\"model\":{\"display_name\":\"Opus\"},\"context_window\":{\"current_usage\":{\"input_tokens\":45000},\"context_window_size\":200000},\"transcript_path\":\"/tmp/test.jsonl\"}' | node dist/index.js"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "hud"
  ],
  "author": "Diego <xbreakmychainsx@gmail.com> (https://github.com/501ego)",
  "contributors": [
    "Jarrod Watts (https://github.com/jarrodwatts)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/501ego/claude-hud"
  },
  "bugs": {
    "url": "https://github.com/501ego/claude-hud/issues"
  },
  "homepage": "https://github.com/501ego/claude-hud",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "c8": "^11.0.0",
    "typescript": "^6.0.2"
  }
}
